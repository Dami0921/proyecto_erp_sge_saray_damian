              "raw": "{{base_url}}/ventas",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ventas"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": null,\n  \"fecha\": \"{{hoy}}\",\n  \"items\": [\n    {\n      \"producto_id\": \"{{producto_id}}\",\n      \"cantidad\": 1\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() - new Date().getTimezoneOffset() * 60000); pm.collectionVariables.set(\"hoy\", d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Trae número de factura\", function () { pm.expect(pm.response.json().data.factura).to.match(/^CV-/); });",
                  "const j = pm.response.json(); pm.collectionVariables.set(\"venta_id\", j.data.id);"
