{
  "info": {
    "name": "ERP AgroInsumos - API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas de la API REST (Clase 13). Ejecutar con Collection Runner: todas las peticiones deben quedar en verde. El login permite 5 intentos por minuto y esta colección hace 5: si se repite antes de un minuto, los login responden 429."
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "1.1 Login vendedor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vendedor@test.com\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Trae token Bearer y rol activo\", function () { const j = pm.response.json(); pm.expect(j.token).to.be.a(\"string\"); pm.expect(j.rol_activo).to.eql(\"vendedor\"); });",
                  "const j = pm.response.json(); pm.collectionVariables.set(\"token_vendedor\", j.token);"
                ]
              }
            }
          ]
        },
